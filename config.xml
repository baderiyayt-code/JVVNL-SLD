<?xml version='1.0' encoding='utf-8'?>
<widget id="com.discom.surveypro" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>DISCOM Pro</name>
    <description>Enterprise Survey App for DISCOM</description>
    <author email="admin@discom.com" href="http://discom.com">Suraj Singh Mehta</author>
    
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
    
    <preference name="AndroidXEnabled" value="true" />
    
    <!-- Req 7: Strict App Icon Usage — res/icon.png is the single source used for every density -->
    <icon src="res/icon.png" />
    
    <platform name="android">
        <allow-intent href="market:*" />
        <!-- Explicitly bind res/icon.png as the launcher icon for every Android density bucket -->
        <icon density="ldpi" src="res/icon.png" />
        <icon density="mdpi" src="res/icon.png" />
        <icon density="hdpi" src="res/icon.png" />
        <icon density="xhdpi" src="res/icon.png" />
        <icon density="xxhdpi" src="res/icon.png" />
        <icon density="xxxhdpi" src="res/icon.png" />
    </platform>

    <plugin name="cordova-plugin-geolocation" />
    <plugin name="cordova-plugin-file" />
</widget>
